# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string (Neon). Use a TEST branch for local development.
# Prefer sslmode=verify-full.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# Public URL of the app (used by Better Auth for callbacks/redirects).
BETTER_AUTH_URL=http://localhost:3000

# Random secret, at least 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Pluggy (Open Finance) ---------------------------------------------------
# From the Pluggy dashboard (application credentials). Server-side only.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# true (default when unset): only Pluggy Sandbox institutions can be connected.
# Set to false only with a Production Pluggy application and real users.
PLUGGY_SANDBOX_ONLY=true
# Secret header Pluggy sends to /api/webhooks/pluggy (x-webhook-secret).
# Only used once a webhook is registered; requests are rejected without it.
PLUGGY_WEBHOOK_SECRET=

# --- Scheduled sync ----------------------------------------------------------
# Bearer secret for GET /api/cron/sync. Vercel Cron sends it automatically.
# At least 16 chars. Generate with: openssl rand -hex 32
CRON_SECRET=
