# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string (Neon). Use a TEST branch for local development.
# Prefer sslmode=verify-full.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# Public URL of the app (used by Better Auth for callbacks/redirects).
BETTER_AUTH_URL=http://localhost:3000

# Random secret, at least 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
